# Copy to `.env.local` and fill in values. Never commit `.env.local`.

# --- Stripe (use Test mode keys from Dashboard for local sandbox testing) ---
# Dashboard → Developers → API keys → toggle "Test mode"
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Local dev: run `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
# and paste the whsec_... shown in the terminal (NOT the Dashboard secret).
# Production / Vercel: use the signing secret from your Dashboard webhook endpoint.
STRIPE_WEBHOOK_SECRET=whsec_...

# Optional: site URL (used elsewhere in the app)
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Meta (Facebook) Pixel — numeric Pixel ID from Events Manager → Data sources → your Pixel
# NEXT_PUBLIC_META_PIXEL_ID=123456789012345
