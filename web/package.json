{
  "name": "kaleidoscope-dental-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "cross-env NODE_OPTIONS=--max-old-space-size=6144 next build --turbopack",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "postinstall": "node scripts/prune-swc.js || exit 0",
    "prepare": "node scripts/prepare.js"
  },
  "dependencies": {
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vercel/blob": "^0.26.0",
    "autoprefixer": "latest",
    "browser-image-compression": "^2.0.2",
    "cobe": "^0.6.5",
    "cross-env": "^10.1.0",
    "firebase": "^11.0.0",
    "firebase-admin": "^13.6.1",
    "gsap": "latest",
    "lucide-react": "^0.564.0",
    "motion": "^12.34.2",
    "next": "latest",
    "postcss": "latest",
    "react": "latest",
    "react-dom": "latest",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.7.0",
    "xlsx": "^0.18.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "eslint": "^9.0.0",
    "eslint-config-next": "latest",
    "eslint-config-prettier": "latest",
    "husky": "latest",
    "lint-staged": "latest",
    "prettier": "latest",
    "ts-node": "^10.9.2"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
